 if(b.ti===0&&g.createConicGradient){const cg=g.createConicGradient(b.rot*2,0,0);['#f00','#ff0','#0f0','#0ff','#00f','#f0f','#f00'].forEach((c,i)=>cg.addColorStop(i/6,c));g.fillStyle=cg;g.beginPath();g.arc(0,0,r+3,0,6.28);g.fill()}
 const rg=g.createRadialGradient(-r*.3,-r*.35,r*.1,0,0,r);rg.addColorStop(0,'#fff');rg.addColorStop(.35,b.ti===0?'#dcdcf0':t.c);rg.addColorStop(1,b.ti===0?'#55556a':t.c);
