let pick=-1;
function setType(r,i){typeSel[r]=i;snap=balls.map(b=>({x:b.x,y:b.y,ang:b.ang}));setup();sel=r}
function pill(x,y,w,h,t,on){g.fillStyle=on?'#7a3cff':'#fff';rr(x,y,w,h,11);g.fill();g.strokeStyle=on?'#7a3cff':'#cfc9e6';g.lineWidth=1.5;g.stroke();tx(t,x+w/2,y+h/2+.5,11,on?'#fff':'#4a4468','center','800')}
function teamStat(s,x){const l=balls.filter(b=>b.side===s);if(l.length===1){stat(l[0],x);return}l.forEach((b,k)=>ol(TY[b.ti].n+': '+fmt(b.dmg*esc()*pw(b))+' dmg'+(b.ti===0?' | laser '+lz(b).n:''),x,508+k*22,12,b.dead?'#999':TY[b.ti].c,'#fff','center',3))}
function ol(s,x,y,sz,fill,st,al='center',lw=4){g.font=`900 ${sz}px ${FONT}`;g.textAlign=al;g.textBaseline='middle';g.lineJoin='round';g.lineWidth=lw;g.strokeStyle=st;g.strokeText(s,x,y);g.fillStyle=fill;g.fillText(s,x,y)}
