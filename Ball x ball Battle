function hit(a,b,px,py){const e=esc();let d=a.dmg*e*pw(a);
 switch(a.ti){
 case 1:a.hc++;a.sp=Math.min(11,TY[1].sp+a.hc*.12);a.dmg=TY[1].dmg+a.hc*.12;break;
 case 2:a.r=Math.min(46,a.r+1.2);a.dmg+=.15;break;
 case 3:b.bs=Math.min(12,b.bs+1);b.bt=240;break;
 case 4:b.slow=Math.min(.5,b.slow+.12);b.st=180;if(b.slow>.2)d*=1.5;break;
 case 5:a.hp=Math.min(a.mx,a.hp+d*.6);fl(a.x,a.y-a.r,'+'+fmt(d*.6),'#19b34a');break;
 case 14:a.dmg*=1.15;break;
 case 19:{const dg=[3,1,4,1,5,9,2,6,5,3,5,8,9,7,9][(a.pi||0)%15];a.pi=(a.pi||0)+1;d*=dg/3.5}break;
 case 20:{a.fa=a.fa||1;a.fb=a.fb||1;d*=.5+.5*a.fa;const nf=a.fa+a.fb;a.fa=a.fb;a.fb=nf;if(a.fa>13){a.fa=1;a.fb=1}}break;
 case 21:{a.hn=(a.hn||0)+1;const n=a.hn;let pr=n>1;for(let k=2;k*k<=n;k++)if(n%k==0)pr=false;if(pr){d*=3;burst(px,py,'#00897b',10,4)}}break;
 case 22:if(b.hp!==Infinity)d=Math.max(d,b.hp*.06);break;
 case 23:d*=(1+Math.floor(Math.random()*6))*.5;break;
 case 24:d*=1+.9*Math.sin(tick/40);break;
 case 25:d*=2**(a.ex||0);a.ex=((a.ex||0)+1)%5;break;
 case 16:d+=a.en||0;if((a.en||0)>1)burst(px,py,'#c0392b',12,5);a.en=0;break;
 case 17:{const kx=b.x-a.x,ky=b.y-a.y,kd=Math.hypot(kx,ky)||1;b.kx=(b.kx||0)+kx/kd*6;b.ky=(b.ky||0)+ky/kd*6}break;
 case 9:b.ps=Math.min(10,b.ps+1);b.pt=360;break;
 case 12:d*=1+(1-a.hp/a.mx)*2;break}
 lg(nmf(a)+(ghost(b)?' meleset dari ':' menghantam ')+nmf(b)+(ghost(b)?'':' (-'+fmt(d)+')'),TY[a.ti].c);hurt(b,d,TY[a.ti].c,px,py);if(b.ti===11&&!ghost(b))hurt(a,d*.35,'#3a9d23',a.x,a.y-a.r);a.hits.push(tick);a.cd=12;burst(px,py,TY[a.ti].c,8,3);shake=Math.max(shake,3)}
function lz(b){const s=sec(),e=esc();return{n:Math.min(14,2+Math.floor(s/4)),d:(.4+s*.05)*e}}
function foe(p){let r=null,bd=1e9;for(const q of balls){if(q.dead||q.side===p.side)continue;const d=Math.hypot(q.x-p.x,q.y-p.y);if(d<bd){bd=d;r=q}}return r}
function step(){tick++;const al=balls.filter(b=>!b.dead);
 for(const p of al){const o=foe(p);if(!o)continue;
  p.cd--;p.fl--;p.rot+=.03;
  if(tick%300==0){p.lv=(p.lv||0)+1;fl(p.x,p.y-p.r-10,'Lv '+(p.lv+1),'#f5a400');burst(p.x,p.y,'#ffd54a',12,4);lg(nmf(p)+' naik ke Lv '+(p.lv+1)+' (+8% damage)','#b8860b')}
  const n=Math.hypot(p.vx,p.vy)||1;p.vx*=p.sp/n;p.vy*=p.sp/n;
  const m=1-p.slow;p.x+=p.vx*m;p.y+=p.vy*m;if(p.kx||p.ky){p.x+=p.kx;p.y+=p.ky;p.kx*=.88;p.ky*=.88}
  const dx=p.x-CX,dy=p.y-CY,d=Math.hypot(dx,dy);
  if(d+p.r>AR){const nx=dx/d,ny=dy/d,dot=p.vx*nx+p.vy*ny;if(dot>0){p.vx-=2*dot*nx;p.vy-=2*dot*ny;if(p.ti===14)p.dmg+=.06}p.x=CX+nx*(AR-p.r);p.y=CY+ny*(AR-p.r)}
  if(tick%2==0){p.tr.push({x:p.x,y:p.y});if(p.tr.length>9)p.tr.shift()}
  if(p.st>0&&--p.st==0)p.slow=0;
  if(p.bt>0){if(tick%30==0)hurt(p,p.bs*.3*esc(),'#ff7a00',p.x,p.y-p.r);if(--p.bt==0)p.bs=0}
  if(p.pt>0){if(tick%30==0)hurt(p,p.ps*.3*esc(),'#5bc21a',p.x,p.y-p.r);if(--p.pt==0)p.ps=0}
  if(p.ti===13&&tick%30==0&&p.hp<p.mx){p.hp=Math.min(p.mx,p.hp+.8);fl(p.x,p.y-p.r,'+0.8','#19b34a')}
  if(p.ti===10){const ax=p.x-o.x,ay=p.y-o.y,ad=Math.hypot(ax,ay)||1;o.x+=ax/ad*.7;o.y+=ay/ad*.7}
  if(p.ti===24)p.sp=TY[24].sp*(1+.35*Math.sin(tick/30));
  if(p.ti===16)p.en=Math.min(6,(p.en||0)+.015);
  if(p.ti===15)for(const q of al){if(q.side===p.side)continue;const bx=p.x-q.x,by=p.y-q.y,bd=Math.hypot(bx,by)||1;if(bd<120){const f=1.2*(1-bd/120)+.15;q.x+=bx/bd*f;q.y+=by/bd*f;if(bd<p.r+q.r+24&&tick%15==0){hurt(q,.6*esc(),'#7a4bd6',q.x,q.y-q.r);if(tick%60==0)lg('Blackhole menggerogoti '+nmf(q),'#7a4bd6')}}}
  if(p.ti===18){p.orb=(p.orb||0)+.09;if(tick%12==0)for(let k=0;k<3;k++){const ex=p.x+Math.cos(p.orb+k*2.094)*(p.r+16),ey=p.y+Math.sin(p.orb+k*2.094)*(p.r+16);for(const q of al){if(q.side!==p.side&&Math.hypot(q.x-ex,q.y-ey)<q.r+5){hurt(q,.7*esc(),'#0aa5c9',ex,ey);burst(ex,ey,'#5be0ff',4,3);if(tick%60==0)lg('Elektron Atom menyetrum '+nmf(q),'#0aa5c9')}}}}
  if(p.ti===7&&tick%90==0){hurt(o,3*esc()*pw(p),'#d9a800',o.x,o.y-o.r);lg('Storm menyambar '+nmf(o)+' (-'+fmt(3*esc()*pw(p))+')','#d9a800');bolts.push({x:o.x,y:o.y,l:10});burst(o.x,o.y,'#ffe14a',14,5);shake=6}
  if(p.ti===0&&tick%12==0){const L=lz(p);for(const q of al){if(q.side===p.side)continue;let tot=0;for(let i=0;i<L.n;i++){const an=p.rot+i*6.283/L.n,ux=Math.cos(an),uy=Math.sin(an),rx=q.x-p.x,ry=q.y-p.y,t=rx*ux+ry*uy;if(t>0&&Math.abs(rx*uy-ry*ux)<q.r)tot+=L.d*pw(p)}if(tot>0){hurt(q,tot,'#c05cff',q.x,q.y-q.r);if(tick%60==0)lg('Laser Disco mengenai '+nmf(q)+' (-'+fmt(tot)+')','#c05cff');burst(q.x,q.y,'#7dff5c',3,2)}}}
  if(p.ti===6){if(++p.mt>=80&&p.mines.length<5){p.mt=0;p.mines.push({x:p.x,y:p.y,t:0})}
   p.mines=p.mines.filter(mi=>{mi.t++;for(const q of al){if(q.side!==p.side&&Math.hypot(q.x-mi.x,q.y-mi.y)<32+q.r){hurt(q,8*esc()*pw(p),'#ff4d4d',mi.x,mi.y);lg('Ranjau Bomber meledak di '+nmf(q),'#e04040');burst(mi.x,mi.y,'#ff9a3c',26,6);burst(mi.x,mi.y,'#333',10,3);shake=10;return false}}return mi.t<900})}}
 for(let i=0;i<al.length;i++)for(let j=i+1;j<al.length;j++){const a=al[i],b=al[j],dx=b.x-a.x,dy=b.y-a.y,d=Math.hypot(dx,dy),md=a.r+b.r;
  if(d<md&&d>0){const nx=dx/d,ny=dy/d,ov=md-d;a.x-=nx*ov/2;a.y-=ny*ov/2;b.x+=nx*ov/2;b.y+=ny*ov/2;
   const da=a.vx*nx+a.vy*ny;if(da>0){a.vx-=2*da*nx;a.vy-=2*da*ny}const db=b.vx*nx+b.vy*ny;if(db<0){b.vx-=2*db*nx;b.vy-=2*db*ny}
   if(a.side!==b.side){const px=a.x+nx*a.r,py=a.y+ny*a.r;if(a.cd<=0)hit(a,b,px,py);if(b.cd<=0)hit(b,a,px,py)}}}
 for(const b of al)if(b.hp<=0){b.hp=0;b.dead=true;lg(nmf(b)+' kalah!','#222');burst(b.x,b.y,TY[b.ti].c,40,7);shake=10}
 const s0=balls.some(b=>!b.dead&&b.side===0),s1=balls.some(b=>!b.dead&&b.side===1);
 if(!s0||!s1){phase='end';winner=s0?0:s1?1:-1;lg(winner<0?'Pertarungan seri':'Tim '+'AB'[winner]+' menang!','#222');shake=14;const w=balls.find(b=>!b.dead);if(w)burst(w.x,w.y,'#ffcc00',60,8)}}
function start(){snap=balls.map(b=>({x:b.x,y:b.y,ang:b.ang}));balls.forEach(b=>{b.vx=Math.cos(b.ang)*b.sp;b.vy=Math.sin(b.ang)*b.sp});phase='fight';tick=0;acc=0;lg('Pertarungan dimulai','#222');lg('Pasif: tiap 5 detik semua bola naik level (+8% damage)','#b8860b')}
let acc=0,si=1;const SP=[.5,1,2,4];
function fx(){for(const p of parts){p.x+=p.vx;p.y+=p.vy;p.vy+=.06;p.l--}parts=parts.filter(p=>p.l>0);for(const f of floats){f.y-=.6;f.l--}bolts.forEach(q=>q.l--);bolts=bolts.filter(q=>q.l>0);floats=floats.filter(f=>f.l>0);shake*=.86}
