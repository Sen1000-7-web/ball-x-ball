let balls,logs=[],bolts=[],parts=[],floats=[],phase='setup',sel=0,drag=null,frame=0,tick=0,shake=0,snap,typeSel=[0,1,4,3],mode=1,winner=null,dragOff;
function mk(ti,side,p,k,n){const d=TY[ti];return{ti,side,dead:false,x:p?p.x:CX+(side?1:-1)*(n>1?92:75),y:p?p.y:CY+(n>1?(k?48:-48):0),ang:p?p.ang:(side?PI-.35:.35),r:d.r,hp:d.hp,mx:d.hp,dmg:d.dmg,sp:d.sp,vx:0,vy:0,cd:0,hits:[],hc:0,bs:0,bt:0,ps:0,pt:0,slow:0,st:0,fl:0,tr:[],mines:[],rot:0,lt:0,mt:0}}
