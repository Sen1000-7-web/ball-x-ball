function wrap(s,x,y,mw,sz,c){g.font=`600 ${sz}px system-ui,sans-serif`;const w=s.split(' ');let l='',ls=[];for(const q of w){if(g.measureText(l+' '+q).width>mw&&l){ls.push(l);l=q}else l=l?l+' '+q:q}ls.push(l);ls.forEach((t,i)=>tx(t,x,y+i*(sz+3),sz,c,'center','600'))}
function rr(x,y,w,h,r){g.beginPath();g.roundRect(x,y,w,h,r)}
function drawBall(b){const t=TY[b.ti],r=b.r;
 b.tr.forEach((p,i)=>{g.globalAlpha=i/b.tr.length*.4;g.fillStyle=t.c;g.beginPath();g.arc(p.x,p.y,r*.22,0,6.28);g.fill()});g.globalAlpha=1;
 g.save();g.translate(b.x,b.y);if(phase==='fight'&&ghost(b))g.globalAlpha=.4;
